{
	"schemaVersion": 1,
	"id": "progressive_adventure",
	"version": "${version}",
	"name": "PAM: Progressive Adventure Mod",
	"description": "Start weak, grow strong. Earn hearts through milestones, get better at what you do, and watch the world open up as you progress.",
	"authors": [
		"joel"
	],
	"license": "MIT",
	"icon": "assets/progressive_adventure/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.progressiveadventure.ProgressiveAdventure"
		],
		"client": [
			"com.progressiveadventure.client.ProgressiveAdventureClient"
		]
	},
	"mixins": [
		"progressive_adventure.mixins.json",
		{
			"config": "progressive_adventure.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
